# Vercel Deployment Secrets
# Do NOT commit the actual `.env.local` to GitHub.
# Define these variables inside Vercel Dashboard > Project Settings > Environment Variables

# The URL of your deployed Node.js / Express backend (e.g., https://timo-backend.up.railway.app)
# MUST BE SET TO THE LIVE BACKEND DOMAIN IN PRODUCTION
NEXT_PUBLIC_API_URL=https://your-backend-url.com

# Stripe Publishable Key (pk_live_... or pk_test_...)
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_...
