# Backend Deployment Secrets
# Do NOT commit `.env` to GitHub.
# Provide these variables in the Railway or Render dashboard.

# Port (Usually injected by the host, e.g., Render/Railway)
PORT=5000

# Environment
NODE_ENV=production

# MongoDB Connection String (e.g., from MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/timo-store?retryWrites=true&w=majority

# JWT Secret for Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Stripe Secret Key (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=sk_test_...

# URL of the deployed frontend (e.g., https://timo-store.vercel.app)
# This is required for CORS and Stripe Redirects
CLIENT_URL=https://your-frontend-url.com
